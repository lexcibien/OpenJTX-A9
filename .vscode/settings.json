{
  "cSpell.words": [
    "AUTOMOC",
    "AUTORCC",
    "AUTOUIC",
    "BINDIR",
    "Cachy",
    "DATAROOTDIR",
    "JTXA",
    "linux",
    "NOLINTNEXTLINE",
    "qreal",
    "QSCALE",
    "qsizetype",
    "qtpaths",
    "SPIWP"
  ],
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  },
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.enable": true,
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/dev"
  ],
  "sonarlint.pathToCompileCommands": "${workspaceFolder}/build/dev/compile_commands.json"
}
